############################################
# iSpaceCoin — ENV PRODUCTION (exemple)
# Copie : cp .env.production.example .env
# Puis : php artisan key:generate
# NE JAMAIS committer le vrai .env
############################################

APP_NAME=iSpaceCoin
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ton-domaine.example

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ─── MySQL 8.4 ───
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ispace_coin
DB_USERNAME=ispace_coin
DB_PASSWORD=CHANGE_ME_STRONG

# ─── Redis (session / cache / queue / Horizon) ───
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.ton-domaine.example
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Mail (SMTP prod) ───
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@ton-domaine.example"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Auth Google ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

SANCTUM_STATEFUL_DOMAINS=ton-domaine.example,www.ton-domaine.example

# ─── Horizon / Telescope ───
HORIZON_PATH=horizon
# Telescope OFF en prod (sauf debug ponctuel)
TELESCOPE_ENABLED=false

# ─── Marchés / actus ───
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_HTTP_TIMEOUT=10
COINGECKO_MCP_URL=
COINGECKO_PRO_API_KEY=
# Préférer CRYPTOCOMPARE_API_KEY (serveur) plutôt que VITE_*
CRYPTOCOMPARE_API_KEY=
VITE_CRYPTOCOMPARE_KEY=
MCP_PROTOCOL_VERSION=2025-06-18

# ─── Wallet / BitGo ───
# prod réel : bitgo + tokens prod — sinon mock
CRYPTO_WALLET_DRIVER=bitgo
BITGO_USE_MOCKS=false
BITGO_TESTNET=false
BITGO_BASE_URL=http://127.0.0.1:3080
BITGO_EXPRESS_API_URL=http://127.0.0.1:3080/api/v2/
BITGO_ACCESS_TOKEN=
BITGO_API_KEY=
BITGO_WALLET_ID=
BITGO_WALLET_ID_BTC=
BITGO_WALLET_ID_ETH=
BITGO_WALLET_ID_USDT=
BITGO_WALLET_PASSPHRASE=
BITGO_DEFAULT_COIN=btc
BITGO_COIN_BTC=btc
BITGO_COIN_ETH=eth
BITGO_COIN_USDT=eth:usdt
BITGO_ENTERPRISE_ID=
WEBHOOK_SIGNING_SECRET=

COINREMITTER_API_KEY=
COINREMITTER_PASSWORD=
COINREMITTER_BTC_API_KEY=
COINREMITTER_BTC_PASSWORD=
COINREMITTER_LTC_API_KEY=
COINREMITTER_LTC_PASSWORD=

# ─── AWS (si S3) ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
